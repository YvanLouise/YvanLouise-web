PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Local admin is passwordless and listens on 127.0.0.1 only.
# Override only when using a different local admin port:
# LOCAL_ADMIN_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,http://127.0.0.1:4174
AUTO_PUBLISH_PUBLIC_SITE=true
AUTO_PUBLISH_REMOTE=origin
AUTO_PUBLISH_BRANCH=main
AUTO_PUBLISH_DEBOUNCE_MS=2500
# DATABASE_URL=postgres://user:password@localhost:5432/yvanlouise
# SECURE_COOKIE=true
# ASSET_STORAGE_MODE=r2
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=yvanlouise-media-dev
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_PUBLIC_BASE_URL=https://media.local.yvanlouise.xyz

# Supabase migration env (used by backend/scripts/migrate-production.ts)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_MEDIA_BUCKET=site-media
